#!/usr/bin/env bash
# snare — find, kill and clean up supply-chain malware in your repos.
# https://github.com/  •  MIT
set -uo pipefail

SNARE_VERSION="1.6.0"

# Fast path for the agent hook. It runs before EVERY shell command an agent
# issues, so the commonest read-only ones must cost almost nothing. It may only
# ever say "this is trivially safe": one simple command, first word on a short
# read-only list, and not a single shell metacharacter — no pipe, no `;`, no
# `$`, no backtick, no brace, not even an escaped newline. Anything else goes
# to the full check. (The first version keyed on trigger words like "npm"
# instead, and `eslint .` — which executes the repo's config — sailed past.)
if [ "${1:-}" = gate ] && [ "${2#--hook}" != "${2:-}" ]; then
  SNARE_HOOK_INPUT="$(cat)"
  _c=""
  _re='"command"[[:space:]]*:[[:space:]]*"(([^"\\]|\\.)*)"'
  [[ $SNARE_HOOK_INPUT =~ $_re ]] && _c="${BASH_REMATCH[1]}"
  _triv='^[[:space:]]*(ls|cat|head|tail|wc|pwd|echo|rg|grep|stat|file|which|type|tree|du|df|diff|sort|uniq|cut|jq|date|whoami|git[[:space:]]+(status|diff|log|show|branch|rev-parse|ls-files|remote|blame|grep|describe|tag|fetch|reflog|shortlog))([[:space:]]|$)'
  _meta='[;&|<>()`$'"'"']|\\[ntr"]|[{}]'
  _flag='(^|[[:space:]])(--pre|--exec|-x|-X|--compress-program|--upload-pack|--receive-pack|-u|-c|--ext-diff|--textconv|--open-files-in-pager|-O)([=[:space:]]|$)'
  if [ -n "$_c" ] && [[ $_c =~ $_triv ]] && ! [[ $_c =~ $_meta ]] && ! [[ $_c =~ $_flag ]]; then
    exit 0
  fi
  export SNARE_HOOK_INPUT
fi
# Resolve through symlinks: install.sh links this into ~/.local/bin, so
# BASH_SOURCE is the link, not the real file. (readlink -f is not portable.)
_src="${BASH_SOURCE[0]}"
while [ -L "$_src" ]; do
  _ldir="$(cd -P "$(dirname "$_src")" && pwd)"
  _src="$(readlink "$_src")"
  case "$_src" in /*) ;; *) _src="$_ldir/$_src" ;; esac
done
_dir="$(cd -P "$(dirname "$_src")/.." && pwd)"

# Windows Git Bash cannot create real symlinks, so install.sh may have copied
# this script rather than linking it. A copy has no link to resolve, so $_dir
# lands next to the copy (e.g. ~/.local) where lib/ does not exist. Rather than
# emitting a dozen "No such file" lines and then "command not found", say what
# is wrong and how to fix it. SNARE_ROOT overrides for unusual layouts.
if [ ! -f "$_dir/lib/common.sh" ]; then
  if [ -n "${SNARE_ROOT:-}" ] && [ -f "$SNARE_ROOT/lib/common.sh" ]; then
    _dir="$SNARE_ROOT"
  else
    {
      echo "snare: cannot find its library files."
      echo "  looked in: $_dir/lib"
      echo
      echo "  This usually means snare was copied instead of linked — Windows"
      echo "  Git Bash cannot always create symlinks."
      echo
      echo "  Fix it by re-running the installer from your snare checkout:"
      echo "      cd /path/to/snare && ./install.sh"
      echo
      echo "  Or point snare at the checkout directly:"
      echo "      export SNARE_ROOT=/path/to/snare"
    } >&2
    exit 1
  fi
fi

# shellcheck source=/dev/null
. "$_dir/lib/common.sh"
. "$_dir/lib/guard.sh"
. "$_dir/lib/scan.sh"
. "$_dir/lib/fix.sh"
. "$_dir/lib/notify.sh"
. "$_dir/lib/update.sh"
. "$_dir/lib/c2.sh"
. "$_dir/lib/selftest.sh"
. "$_dir/lib/report.sh"
. "$_dir/lib/baseline.sh"
. "$_dir/lib/hook.sh"
. "$_dir/lib/ci.sh"
. "$_dir/lib/shield.sh"
. "$_dir/lib/gate.sh"
. "$_dir/lib/agents.sh"
. "$_dir/lib/rotate.sh"
. "$_dir/lib/respond.sh"
. "$_dir/lib/deps.sh"
. "$_dir/lib/doctor.sh"

usage(){ cat <<USAGE
${C_BLD}snare${C_OFF} v$SNARE_VERSION — trap supply-chain malware before it runs

${C_BLD}START HERE${C_OFF}
  snare deps [dir] [--system]   known-malicious packages in lockfiles and installs —
                                npm, PyPI, crates.io, Go, RubyGems, Packagist, NuGet
  snare deps fix [dir]          remove them, or replace with a version not listed (asks)
  snare deps update | status    refresh / show the known-malware list (same file for everyone)
  snare respond                 guided clean-up: rotate, machine, repos, notify
  snare respond --status        where you got to
  snare respond --reset         start the walkthrough again

${C_BLD}TRACK${C_OFF}
  snare guard status            is the monitor running?
  snare guard install           run it at login (kills the loader within ~1s)
  snare guard scan              one-shot check of this machine
  snare guard log               follow the log
  snare guard origins           where detections came from (the file to clean)
  snare guard start | stop      restart it after an update
  snare guard uninstall
  snare c2                      the C2 the guard kills on, live from the dead drop
  snare c2 --refresh            re-resolve it now (otherwise daily, in the background)

${C_BLD}FIND${C_OFF}
  snare scan                    scan the current directory
  snare scan repo [path]        deep-scan one clone: tree, all branches, history
  snare scan repo [path] --new  only findings that are not in the baseline
  snare scan orgs               list every org/account you can reach, with counts
  snare scan orgs --all         include individual accounts, not just orgs
  snare scan github             every repo you can reach, via API (no cloning)
  snare scan github --pick      choose which orgs to scan, from a list
  snare scan github --owner a,b only these orgs/accounts (comma-separated)
  snare scan github --mine      only repos you own
  snare scan github --all-branches
  snare doctor                  check this machine + your GitHub account
  snare rotate                  what to revoke, and audit GitHub for persistence
  snare selftest                prove detection works (known-bad + known-good)

${C_BLD}WATCH${C_OFF}
  snare report                  scan, save a timestamped report, exit non-zero on findings
  snare report --json           machine-readable, for CI
  snare schedule install --daily     run it on a timer, notify on findings (opt-in)
  snare schedule status | uninstall
  snare baseline set            accept current findings; later scans show only what is new
  snare baseline status | clear

${C_BLD}PREVENT${C_OFF}
  snare agents install          make coding agents scan before they clone, pull, install or run
  snare agents status | uninstall
  snare agents install --project [dir]   also this repo's CLAUDE.md, AGENTS.md and hook
  snare gate -- <command>       scan first; exit 0 means safe to run it
  snare gate allow [dir [branch]|url]  you looked and it is yours: allow what was flagged,
                                on disk or still incoming (asks per item)
  snare gate allowed | forget [dir|all]
  snare shield install          scan before npm/pnpm/yarn/bun/git clone runs anything
  snare shield status | uninstall
  snare shield check [path]     the fast check on its own, without installing
  snare hook install            block a push that carries a hidden payload
  snare hook install --with-pre-commit
  snare hook status | uninstall
  snare ci install              block merges until a repo passes the scan (GitHub Actions)
  snare ci status | print

${C_BLD}MAINTAIN${C_OFF}
  snare update                  pull the latest version
  snare update --check          is a newer version available?
  snare update --relink         point ~/.local/bin/snare at THIS checkout

${C_BLD}FIX${C_OFF}
  snare fix <owner/repo>                      dry run (always backs up first)
  snare fix --all                             every repo the last scan flagged
  snare fix --pick                            choose orgs, scan them, then fix
  snare fix --pick --purge-history --push     ... and erase it from all history
  snare fix --owner a,b --push                the same, without the prompt
  snare fix <owner/repo> --push               clean branch tips and push
  snare fix <owner/repo> --purge-history --push   erase from all history

${C_BLD}INFORM${C_OFF}
  snare notify <owner/repo>            list collaborators + preview
  snare notify <owner/repo> --issue    file a GitHub issue @-mentioning them
  snare notify <owner/repo> --mail     open a pre-filled mail draft per person

${C_BLD}HELP${C_OFF}
  snare help                    this list
  snare version                 version, and whether a newer one exists

${C_BLD}AUTH${C_OFF}
  snare uses ${C_BLD}your own${C_OFF} GitHub credentials. No token ships with this tool.
      gh auth login              browser, or paste a token
      export GH_TOKEN=...        scopes needed: repo, workflow

State lives in \$SNARE_HOME (default ~/.snare): logs, evidence, backups.
USAGE
}

main(){
  local c="${1:-help}"; shift || true
  case "$c" in
    guard)  cmd_guard "$@" ;;
    scan)
      local what="${1:-}"; shift || true
      case "$what" in
        repo)
          local _t="${1:-$PWD}" _new=0
          [ "$_t" = "--new" ] && { _new=1; _t="${2:-$PWD}"; }
          [ "${2:-}" = "--new" ] && _new=1
          if [ "$_new" = 1 ]; then
            snare_baseline_filter "$_t" "$(cmd_scan_repo "$_t" 2>&1)"
          else cmd_scan_repo "$_t"; fi ;;
        github) cmd_scan_github "$@" ;;
        orgs|owners) cmd_scan_orgs "$@" ;;
        "")     cmd_scan_repo "$PWD" ;;
        *)      cmd_scan_repo "$what" ;;
      esac ;;
    fix)
      case "${1:-}" in
        --all)          shift; cmd_fix_all "$@" ;;
        --pick|--select|--owner) cmd_fix_pick "$@" ;;
        *)              cmd_fix "$@" ;;
      esac ;;
    notify) cmd_notify "$@" ;;
    doctor) cmd_doctor ;;
    update) cmd_update "$@" ;;
    report) cmd_report "$@" ;;
    schedule) cmd_schedule "$@" ;;
    baseline) cmd_baseline "$@" ;;
    hook)   cmd_hook "$@" ;;
    ci)     cmd_ci "$@" ;;
    shield) cmd_shield "$@" ;;
    gate)   cmd_gate "$@" ;;
    agents) cmd_agents "$@" ;;
    rotate) cmd_rotate "$@" ;;
    # internal: the detached cache refresh behind the update nudge
    c2)     cmd_c2 "$@" ;;
    _update-refresh) snare_update_refresh; exit 0 ;;
    # internal: the detached dead-drop refresh behind the guard's kill list
    _c2-refresh) snare_c2_refresh; exit 0 ;;
    respond) cmd_respond "$@" ;;
    deps)   cmd_deps "$@" ;;
    # internal: the detached known-malware list refresh
    _intel-refresh) snare_intel_refresh; rm -f "$INTEL_DIR/.refreshing"; exit 0 ;;
    selftest) cmd_selftest "$@" ;;
    version|--version|-v)
      _sha="$(git -C "$_dir" rev-parse --short HEAD 2>/dev/null)"
      if [ -n "$_sha" ]; then echo "snare $SNARE_VERSION ($_sha)"; else echo "snare $SNARE_VERSION"; fi
      snare_update_hint ;;
    help|--help|-h) usage ;;
    *) red "unknown command: $c"; echo; usage; exit 2 ;;
  esac
}
# One-time migration onto the agent gate. `snare update` cannot do this for
# the people who need it most: the process running the update is still the
# OLD code, which has never heard of the gate, so an upgrade from 1.4.x
# finished cleanly and left the gate uninstalled — measured, not supposed.
# So the first command the NEW code runs ASKS, once, at a terminal. Not in
# the hook's hot path, not in CI, not under an agent, never after a "no" or
# `snare agents uninstall`.
case "${1:-}" in
  gate|agents|_update-refresh|_c2-refresh|_intel-refresh) ;;
  *)
    # Ask once, at a terminal, before touching anyone's agent files. An
    # upgrade from 1.4.x used to switch this on without asking.
    if [ -z "${SNARE_NO_AGENTS:-}" ] && [ -t 0 ] && [ -t 1 ] \
       && [ ! -f "$SNARE_HOME/agents-migrated" ] && [ ! -f "$SNARE_HOME/agents-declined" ] \
       && { [ -d "$HOME/.claude" ] || [ -d "$HOME/.codex" ] || [ -d "$HOME/.gemini" ]; }; then
      case "${1:-}" in
        gate|agents|selftest|version|--version|-v|help|--help|-h) ;;
        *) snare_agents_offer || true ;;
      esac
    fi ;;
esac

# One line, at most once a day, never blocking — see snare_update_nudge.
# Runs after the command so it never delays output, and never changes the
# command's own exit status.
_snare_rc=0
main "$@" || _snare_rc=$?
snare_update_nudge 2>/dev/null || true
exit "$_snare_rc"
